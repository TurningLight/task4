#owner: 2877259531-afk
#owner group: oceanbase
#description: prune redundant integer bounds in ANN filters

--disable_query_log

--disable_warnings
DROP TABLE IF EXISTS ann_redundant_bounds;
--enable_warnings

CREATE TABLE ann_redundant_bounds (
  id INT PRIMARY KEY,
  age INT,
  v VECTOR(3),
  KEY idx_age(age),
  VECTOR INDEX hnsw(v)
    WITH (
      distance=l2,
      type=hnsw,
      lib=vsag,
      m=16,
      ef_construction=128,
      sync_mode=immediate
    )
) ORGANIZATION HEAP;

INSERT INTO ann_redundant_bounds VALUES
  (1, 1,    '[1,0,0]'),
  (2, 9,    '[2,0,0]'),
  (3, 10,   '[3,0,0]'),
  (4, 20,   '[4,0,0]'),
  (5, NULL, '[5,0,0]'),
  (6, 0,    '[6,0,0]'),
  (7, 30,   '[7,0,0]'),
  (8, -1,   '[8,0,0]');

ANALYZE TABLE ann_redundant_bounds;

--replace_regex /, $/,/

EXPLAIN BASIC
SELECT id
FROM ann_redundant_bounds
WHERE age < 10 AND age < 20 AND age <= 30
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

SELECT id
FROM ann_redundant_bounds
WHERE age < 10 AND age < 20 AND age <= 30
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

SELECT id
FROM ann_redundant_bounds
WHERE age > 0 AND age > -1 AND age >= 0
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

SELECT id
FROM ann_redundant_bounds
WHERE age <= 10 AND age < 10 AND age < 20
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

SELECT id
FROM ann_redundant_bounds
WHERE 20 > age AND 10 > age
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

SELECT id
FROM ann_redundant_bounds
WHERE age < 30 OR age < 50
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

--replace_regex /, $/,/

EXPLAIN BASIC
SELECT /*+ NO_REWRITE */ id
FROM ann_redundant_bounds
WHERE age < 10 AND age < 20
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

PREPARE ann_bounds_stmt FROM
'SELECT id FROM ann_redundant_bounds
 WHERE age < ? AND age < ?
 ORDER BY l2_distance(v, ''[0,0,0]'') APPROXIMATE LIMIT 10';

SET @a = 10, @b = 20;
EXECUTE ann_bounds_stmt USING @a, @b;

SET @a = 20, @b = 10;
EXECUTE ann_bounds_stmt USING @a, @b;

SET @a = 20, @b = 30;
EXECUTE ann_bounds_stmt USING @a, @b;

SET @a = NULL, @b = 30;
EXECUTE ann_bounds_stmt USING @a, @b;

DEALLOCATE PREPARE ann_bounds_stmt;

SELECT id
FROM ann_redundant_bounds
WHERE age > 30 AND age < 20
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE
LIMIT 10;

DROP TABLE ann_redundant_bounds;

--enable_query_log
