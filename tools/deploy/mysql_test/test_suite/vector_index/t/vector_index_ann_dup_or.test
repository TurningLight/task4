# Regression for issue #1489: repeated OR disjuncts must not be evaluated for every ANN candidate.
# The 128 repeated (age > 1000) disjuncts are equivalent to a single one.
SET ob_query_timeout = 20000000;
SET ob_trx_timeout = 60000000;
SET ob_hnsw_ef_search = 64;
CREATE DATABASE IF NOT EXISTS seekdb_ann_or_regression;
USE seekdb_ann_or_regression;
DROP TABLE IF EXISTS t_ann_dup_or;
CREATE TABLE t_ann_dup_or (id INT PRIMARY KEY, embedding VECTOR(3) NOT NULL, category INT NOT NULL, age INT NOT NULL);
INSERT INTO t_ann_dup_or VALUES (1,'[1,0,0]',1,10),(2,'[0.875,0,0]',2,10),(3,'[0.75,0,0]',1,20),(4,'[0.625,0,0]',2,20),(5,'[0.5,0,0]',3,30),(6,'[0.375,0,0]',4,40);
CREATE VECTOR INDEX idx_ann_dup_or ON t_ann_dup_or(embedding) WITH (distance=l2, type=hnsw, lib=vsag, m=16, ef_construction=128);
SELECT id FROM t_ann_dup_or WHERE category = 1 OR category = 2 ORDER BY l2_distance(embedding, '[1,0,0]') APPROXIMATE LIMIT 3;
SELECT id FROM t_ann_dup_or WHERE (category = 1 OR category = 2) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000) OR (age > 1000)